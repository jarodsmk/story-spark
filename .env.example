# StorySpark Environment Variables
# NEVER commit your real API keys to version control.
# Copy this file to .env and insert your personal local or cloud LLM keys.

# Optional Bring-Your-Own-Model API Key (OpenRouter, OpenAI, or custom provider)
VITE_LLM_API_KEY=

# LLM Base URL (defaults to OpenRouter, or configure local Ollama / LM Studio / OpenAI)
# Example OpenRouter: https://openrouter.ai/api/v1
# Example Ollama: http://localhost:11434/v1
# Example OpenAI: https://api.openai.com/v1
# Example LM Studio: http://localhost:1234/v1
VITE_LLM_BASE_URL=https://openrouter.ai/api/v1

# Default model name
# Default: microsoft/wizardlm-2-8x22b
# Other examples: openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct, mistralai/mistral-large
VITE_LLM_MODEL=microsoft/wizardlm-2-8x22b

